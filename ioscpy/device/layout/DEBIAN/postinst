#!/bin/sh
set -e

# Resolve the active prefix from where dpkg installed the daemon, the same way the
# runtime resolver does, so the plist points at the real binary on rootless
# (/var/jb), rootful (""), or a roothide prefix ($JBROOT).
if [ -x /var/jb/usr/bin/ioscpyd ]; then
    PREFIX=/var/jb
elif [ -n "$JBROOT" ] && [ -x "$JBROOT/usr/bin/ioscpyd" ]; then
    PREFIX="$JBROOT"
elif command -v jbroot >/dev/null 2>&1 && [ -x "$(jbroot / 2>/dev/null)/usr/bin/ioscpyd" ]; then
    PREFIX="$(jbroot / 2>/dev/null)"
    PREFIX="${PREFIX%/}"
elif [ -x /usr/bin/ioscpyd ]; then
    PREFIX=""
else
    echo "ioscpy: installed daemon not found; aborting" >&2
    exit 1
fi

DAEMON="$PREFIX/usr/bin/ioscpyd"
CTL="$PREFIX/usr/bin/ioscpyctl"
LDDIR="$PREFIX/Library/LaunchDaemons"
PLIST="$LDDIR/com.ioscpy.daemon.plist"
LOGDIR="$PREFIX/var/log/ioscpy"

mkdir -p "$LDDIR" "$LOGDIR"
chmod 755 "$DAEMON" "$CTL" 2>/dev/null || true
chown root:wheel "$DAEMON" "$CTL" 2>/dev/null || true

# ElleKit loads tweaks from usr/lib/TweakInject. Older ioscpy packages unpacked a
# real MobileSubstrate/DynamicLibraries directory and hid that symlink, so the
# hook never entered SpringBoard.
INJECT="$PREFIX/usr/lib/TweakInject"
MSDIR="$PREFIX/Library/MobileSubstrate/DynamicLibraries"
mkdir -p "$INJECT" "$PREFIX/Library/MobileSubstrate"
if [ -d "$MSDIR" ] && [ ! -L "$MSDIR" ]; then
    echo "ioscpy: moving tweaks into TweakInject (was a real directory)"
    mv "$MSDIR"/* "$INJECT/" 2>/dev/null || true
    rm -rf "$MSDIR"
fi
if [ ! -e "$MSDIR" ]; then
    ln -s ../../usr/lib/TweakInject "$MSDIR" 2>/dev/null || ln -s "$INJECT" "$MSDIR"
fi
# Theos 0.1.12 installs the hook into TweakInject. Keep a copy if an old
# package left the dylib only under MobileSubstrate.
if [ ! -f "$INJECT/ioscpyhook.dylib" ]; then
    for candidate in \
        "$PREFIX/Library/MobileSubstrate/DynamicLibraries/ioscpyhook.dylib" \
        /var/jb/Library/MobileSubstrate/DynamicLibraries/ioscpyhook.dylib; do
        if [ -f "$candidate" ]; then
            cp -f "$candidate" "$INJECT/ioscpyhook.dylib" 2>/dev/null || true
            cp -f "${candidate%.dylib}.plist" "$INJECT/ioscpyhook.plist" 2>/dev/null || true
            break
        fi
    done
fi
chmod 755 "$INJECT/ioscpyhook.dylib" 2>/dev/null || true
chmod 644 "$INJECT/ioscpyhook.plist" 2>/dev/null || true

# ElleKit may look at TweakInject or at MobileSubstrate/DynamicLibraries. If the
# latter is a real directory (broken symlink), put a copy there too.
if [ -f "$INJECT/ioscpyhook.dylib" ]; then
    mkdir -p "$MSDIR"
    cp -f "$INJECT/ioscpyhook.dylib" "$MSDIR/ioscpyhook.dylib" 2>/dev/null || true
    cp -f "$INJECT/ioscpyhook.plist" "$MSDIR/ioscpyhook.plist" 2>/dev/null || true
    chmod 755 "$MSDIR/ioscpyhook.dylib" 2>/dev/null || true
    chmod 644 "$MSDIR/ioscpyhook.plist" 2>/dev/null || true
    mkdir -p "$PREFIX/Library/TweakInject"
    cp -f "$INJECT/ioscpyhook.dylib" "$PREFIX/Library/TweakInject/ioscpyhook.dylib" 2>/dev/null || true
    cp -f "$INJECT/ioscpyhook.plist" "$PREFIX/Library/TweakInject/ioscpyhook.plist" 2>/dev/null || true
fi

cat > "$PLIST" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ioscpy.daemon</string>
	<key>Program</key>
	<string>$DAEMON</string>
	<key>ProgramArguments</key>
	<array>
		<string>$DAEMON</string>
	</array>
	<key>UserName</key>
	<string>root</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>$LOGDIR/ioscpyd.log</string>
	<key>StandardErrorPath</key>
	<string>$LOGDIR/ioscpyd.log</string>
</dict>
</plist>
PLISTEOF
chmod 644 "$PLIST"
plutil -lint "$PLIST" >/dev/null 2>&1 || true

# (Re)load the daemon through launchd. enable in case the label was left disabled,
# else kickstart silently won't start it.
launchctl bootout system "$PLIST" 2>/dev/null || true
launchctl enable system/com.ioscpy.daemon 2>/dev/null || true
launchctl bootstrap system "$PLIST" 2>/dev/null || launchctl load "$PLIST" 2>/dev/null || true
launchctl kickstart -k system/com.ioscpy.daemon 2>/dev/null || true

echo "ioscpy installed. In Sileo tap Restart SpringBoard when it asks — do not force-kill it from here."
exit 0
