#!/bin/sh
# Do NOT use set -e here: a failed launchctl/path probe must not roll back the
# whole package. Sileo then shows "Готово" but the Get button returns.

PKG=com.ioscpy.device

find_daemon() {
    # 1) Wherever dpkg actually unpacked the file (works on rootless + roothide).
    if command -v dpkg-query >/dev/null 2>&1; then
        dpkg-query -L "$PKG" 2>/dev/null | grep -E '/usr/bin/ioscpyd$' | head -n1
        return 0
    fi
    return 0
}

DAEMON="$(find_daemon)"

if [ -z "$DAEMON" ] || [ ! -x "$DAEMON" ]; then
    for c in \
        "$JBROOT/usr/bin/ioscpyd" \
        /var/jb/usr/bin/ioscpyd \
        /usr/bin/ioscpyd
    do
        if [ -n "$c" ] && [ -x "$c" ]; then
            DAEMON="$c"
            break
        fi
    done
fi

if [ -z "$DAEMON" ] || [ ! -x "$DAEMON" ]; then
    if command -v jbroot >/dev/null 2>&1; then
        c="$(jbroot /usr/bin/ioscpyd 2>/dev/null)"
        if [ -n "$c" ] && [ -x "$c" ]; then
            DAEMON="$c"
        fi
    fi
fi

if [ -z "$DAEMON" ] || [ ! -x "$DAEMON" ]; then
    echo "ioscpy: warning: ioscpyd not found after unpack; package kept installed" >&2
    echo "ioscpy: dpkg -L $PKG | head:" >&2
    dpkg-query -L "$PKG" 2>/dev/null | head -n 30 >&2 || true
    exit 0
fi

# Prefix = everything before /usr/bin/ioscpyd
PREFIX="${DAEMON%/usr/bin/ioscpyd}"
CTL="$PREFIX/usr/bin/ioscpyctl"
LDDIR="$PREFIX/Library/LaunchDaemons"
PLIST="$LDDIR/com.ioscpy.daemon.plist"
LOGDIR="$PREFIX/var/log/ioscpy"
INJECT="$PREFIX/usr/lib/TweakInject"
MSDIR="$PREFIX/Library/MobileSubstrate/DynamicLibraries"

echo "ioscpy: daemon=$DAEMON prefix=${PREFIX:-/}"

mkdir -p "$LDDIR" "$LOGDIR" "$INJECT" "$PREFIX/Library/MobileSubstrate" 2>/dev/null || true
chmod 755 "$DAEMON" 2>/dev/null || true
chmod 755 "$CTL" 2>/dev/null || true
chown root:wheel "$DAEMON" "$CTL" 2>/dev/null || true

# ElleKit: TweakInject is canonical; keep MobileSubstrate/DynamicLibraries in sync.
if [ -d "$MSDIR" ] && [ ! -L "$MSDIR" ]; then
    echo "ioscpy: migrating real MobileSubstrate/DynamicLibraries -> TweakInject"
    mv "$MSDIR"/* "$INJECT/" 2>/dev/null || true
    rm -rf "$MSDIR" 2>/dev/null || true
fi
if [ ! -e "$MSDIR" ]; then
    ln -s ../../usr/lib/TweakInject "$MSDIR" 2>/dev/null || ln -s "$INJECT" "$MSDIR" 2>/dev/null || true
fi

if [ ! -f "$INJECT/ioscpyhook.dylib" ]; then
    for candidate in \
        "$MSDIR/ioscpyhook.dylib" \
        "$PREFIX/Library/MobileSubstrate/DynamicLibraries/ioscpyhook.dylib"
    do
        if [ -f "$candidate" ]; then
            cp -f "$candidate" "$INJECT/ioscpyhook.dylib" 2>/dev/null || true
            cp -f "${candidate%.dylib}.plist" "$INJECT/ioscpyhook.plist" 2>/dev/null || true
            break
        fi
    done
fi

if [ -f "$INJECT/ioscpyhook.dylib" ]; then
    chmod 755 "$INJECT/ioscpyhook.dylib" 2>/dev/null || true
    chmod 644 "$INJECT/ioscpyhook.plist" 2>/dev/null || true
    mkdir -p "$MSDIR" 2>/dev/null || true
    cp -f "$INJECT/ioscpyhook.dylib" "$MSDIR/ioscpyhook.dylib" 2>/dev/null || true
    cp -f "$INJECT/ioscpyhook.plist" "$MSDIR/ioscpyhook.plist" 2>/dev/null || true
    mkdir -p "$PREFIX/Library/TweakInject" 2>/dev/null || true
    cp -f "$INJECT/ioscpyhook.dylib" "$PREFIX/Library/TweakInject/ioscpyhook.dylib" 2>/dev/null || true
    cp -f "$INJECT/ioscpyhook.plist" "$PREFIX/Library/TweakInject/ioscpyhook.plist" 2>/dev/null || true
    echo "ioscpy: hook installed at $INJECT/ioscpyhook.dylib"
else
    echo "ioscpy: warning: ioscpyhook.dylib missing under $INJECT" >&2
fi

cat > "$PLIST" <<PLISTEOF || true
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ioscpy.daemon</string>
	<key>Program</key>
	<string>$DAEMON</string>
	<key>ProgramArguments</key>
	<array>
		<string>$DAEMON</string>
	</array>
	<key>UserName</key>
	<string>root</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>$LOGDIR/ioscpyd.log</string>
	<key>StandardErrorPath</key>
	<string>$LOGDIR/ioscpyd.log</string>
</dict>
</plist>
PLISTEOF
chmod 644 "$PLIST" 2>/dev/null || true
plutil -lint "$PLIST" >/dev/null 2>&1 || true

launchctl bootout system "$PLIST" 2>/dev/null || true
launchctl enable system/com.ioscpy.daemon 2>/dev/null || true
launchctl bootstrap system "$PLIST" 2>/dev/null || launchctl load "$PLIST" 2>/dev/null || true
launchctl kickstart -k system/com.ioscpy.daemon 2>/dev/null || true

echo "ioscpy installed. In Sileo tap Restart SpringBoard when asked."
exit 0
